javascript:(function(){if(document.getElementById('ai-analyser-btn'))return;const btn=document.createElement('button');btn.id='ai-analyser-btn';btn.innerText='🧠';btn.style.position='fixed';btn.style.bottom='20px';btn.style.right='20px';btn.style.zIndex='999999';btn.style.width='60px';btn.style.height='60px';btn.style.borderRadius='50%';btn.style.backgroundColor='#0f172a';btn.style.color='#38bdf8';btn.style.border='2px solid #38bdf8';btn.style.fontSize='24px';btn.style.fontWeight='bold';btn.style.cursor='grab';btn.style.boxShadow='0 0 20px rgba(56,189,248,0.4)';btn.style.userSelect='none';btn.style.touchAction='none';document.body.appendChild(btn);const panel=document.createElement('div');panel.id='ai-analyser-panel';panel.style.position='fixed';panel.style.zIndex='999998';panel.style.width='220px';panel.style.padding='14px';panel.style.borderRadius='14px';panel.style.backgroundColor='#0f172a';panel.style.border='1.5px solid #38bdf8';panel.style.boxShadow='0 10px 25px rgba(0,0,0,0.6)';panel.style.color='#f8fafc';panel.style.fontFamily='sans-serif';panel.style.fontSize='13px';panel.style.display='none';panel.style.backdropFilter='blur(8px)';document.body.appendChild(panel);const overlay=document.createElement('div');overlay.id='ai-analyser-overlay';overlay.style.position='fixed';overlay.style.top='0';overlay.style.left='0';overlay.style.width='100vw';overlay.style.height='100vh';overlay.style.backgroundColor='rgba(15, 23, 42, 0.85)';overlay.style.zIndex='999997';overlay.style.display='none';overlay.style.flexDirection='column';overlay.style.alignItems='center';overlay.style.justifyContent='center';overlay.style.backdropFilter='blur(6px)';overlay.innerHTML='<div style="width:70px;height:70px;border:5px solid #1e293b;border-top:5px solid #38bdf8;border-radius:50%;animation:aiSpin 1s linear infinite;margin-bottom:20px;"></div><div style="color:#38bdf8;font-size:18px;font-weight:bold;font-family:sans-serif;letter-spacing:1px;" id="ai-status">READING DASHBOARD...</div><style>@keyframes aiSpin{0%{transform:rotate(0deg);}100%{transform:rotate(360deg);}}</style>';document.body.appendChild(overlay);function updatePanelPos(){const rect=btn.getBoundingClientRect();let top=rect.top;let left=rect.left-235;if(left<10)left=rect.right+15;if(top+180>window.innerHeight)top=window.innerHeight-190;panel.style.left=%60${Math.max(10,left)}px%60;panel.style.top=%60${Math.max(10,top)}px%60;}let isDragging=false,hasMoved=false,startX,startY,initialX,initialY;const startDrag=(e)=>{isDragging=true;hasMoved=false;btn.style.cursor='grabbing';const clientX=e.touches?e.touches[0].clientX:e.clientX;const clientY=e.touches?e.touches[0].clientY:e.clientY;startX=clientX;startY=clientY;const rect=btn.getBoundingClientRect();initialX=rect.left;initialY=rect.top;};const doDrag=(e)=>{if(!isDragging)return;const clientX=e.touches?e.touches[0].clientX:e.clientX;const clientY=e.touches?e.touches[0].clientY:e.clientY;const dx=clientX-startX;const dy=clientY-startY;if(Math.abs(dx)>3||Math.abs(dy)>3)hasMoved=true;btn.style.left=%60${initialX+dx}px%60;btn.style.top=%60${initialY+dy}px%60;btn.style.bottom='auto';btn.style.right='auto';if(panel.style.display==='block')updatePanelPos();};const stopDrag=()=>{isDragging=false;btn.style.cursor='grab';};btn.addEventListener('mousedown',startDrag);document.addEventListener('mousemove',doDrag);document.addEventListener('mouseup',stopDrag);btn.addEventListener('touchstart',startDrag,{passive:true});document.addEventListener('touchmove',doDrag,{passive:true});document.addEventListener('touchend',stopDrag);btn.addEventListener('click',()=>{if(hasMoved)return;overlay.style.display='flex';panel.style.display='none';const statusEl=document.getElementById('ai-status');statusEl.innerText='READING DASHBOARD...';setTimeout(()=>{statusEl.innerText='ANALYZING PATTERNS...';},700);setTimeout(()=>{statusEl.innerText='CALCULATING PROBABILITY...';},1400);setTimeout(()=>{overlay.style.display='none';const options=[{type:'TYPE',value:'BIG',acc:Math.floor(Math.random()*12)+83},{type:'TYPE',value:'SMALL',acc:Math.floor(Math.random()*12)+83},{type:'COLOUR',value:'GREEN',acc:Math.floor(Math.random()*10)+78},{type:'COLOUR',value:'RED',acc:Math.floor(Math.random()*10)+78},{type:'NUMBER',value:'7',acc:Math.floor(Math.random()*8)+68}];const best=options.sort((a,b)=>b.acc-a.acc)[0];panel.innerHTML=%60<div style="font-weight:bold;color:#94a3b8;font-size:11px;margin-bottom:8px;border-bottom:1px solid #334155;padding-bottom:4px;display:flex;justify-between;align-items:center;"><span>AI PREDICTION</span><span style="color:#22c55e;">● LIVE</span></div><div style="margin-bottom:6px;"><span style="color:#94a3b8;font-size:11px;">SIGNAL:</span> <strong style="color:#38bdf8;font-size:16px;float:right;">${best.value}</strong></div><div style="margin-bottom:6px;"><span style="color:#94a3b8;font-size:11px;">CATEGORY:</span> <span style="color:#f8fafc;float:right;font-weight:600;">${best.type}</span></div><div><span style="color:#94a3b8;font-size:11px;">ACCURACY:</span> <strong style="color:#4ade80;font-size:14px;float:right;">${best.acc}%</strong></div>%60;updatePanelPos();panel.style.display='block';},2000);});})();
